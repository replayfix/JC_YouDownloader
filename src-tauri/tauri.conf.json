{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JC_YouDownloader",
  "version": "0.1.0",
  "identifier": "com.jc.youdownloader",
  "build": {
    "beforeDevCommand": "bun run fetch-binaries && bun run dev",
    "devUrl": "http://localhost:10000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "JC_YouDownloader",
        "width": 900,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' asset: https://asset.localhost https: data:; connect-src ipc: http://ipc.localhost https://api.github.com https://github.com"
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "category": "Utility",
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator3"
        ]
      }
    },
    "resources": {
      "binaries/*": "binaries/",
      "binaries/ytdlp": "binaries/ytdlp"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
